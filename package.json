{
  "name": "swarna-live",
  "version": "2.0.0",
  "description": "Swarna Live - loan and customer records manager",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --no-warnings=ExperimentalWarning server.js",
    "test": "node --no-warnings=ExperimentalWarning --test test/*.test.js",
    "cf:dev": "wrangler dev",
    "cf:setup": "bash scripts/cloudflare-setup.sh",
    "cf:deploy": "wrangler d1 migrations apply swarna-live-db --remote && wrangler deploy"
  },
  "engines": {
    "node": ">=22.5"
  },
  "devDependencies": {
    "wrangler": "^4.40.0"
  }
}
